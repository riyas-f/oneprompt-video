# Discord
DISCORD_BOT_TOKEN=
# Public Key from Developer Portal → General Information.
# Required to verify Discord's "Webhook Events" requests (APPLICATION_AUTHORIZED).
DISCORD_PUBLIC_KEY=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://oneprompt:oneprompt@localhost:5432/oneprompt

# Polar.sh (https://docs.polar.sh)
# Personal/Organization access token from Polar dashboard → Settings → Developers.
POLAR_ACCESS_TOKEN=
# Webhook secret from Polar dashboard → Settings → Webhooks (starts with polar_whs_).
POLAR_WEBHOOK_SECRET=
# Product ID for "OnePrompt Pro" (recurring monthly with 7-day free trial).
POLAR_PRODUCT_ID=
POLAR_API_BASE=https://api.polar.sh
# Optional — Polar's hosted thank-you page is used if blank.
POLAR_SUCCESS_URL=
# Trial length configured on the Polar product (used for display only).
POLAR_TRIAL_DAYS=7

# Encryption — generate ONCE with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: losing this key bricks every stored Modal credential. Back it up.
ENCRYPTION_KEY=

# Modal
MODAL_APP_PATH=./modal_app/app.py
MODAL_GRAPHQL_URL=https://api.modal.com/graphql
# Bot owner's deployed modal_app/app.py — used for free-tier generations
# (deploy once with `cd modal_app && modal deploy app.py`, paste the URL).
ADMIN_MODAL_URL=
# Lifetime free generations per Discord user before /subscribe is required.
FREE_GENERATIONS=2

# API server (video generation)
VIDEO_API_URL=https://flow.yayce.com/webhook-test/video-gen-endpoint
VIDEO_API_CALLBACK_SECRET=

# Where the API server reaches the bot's webhook (publicly resolvable)
BOT_PUBLIC_URL=https://bot.oneprompt.app

# Support
SUPPORT_DISCORD_USER_ID=

# Webhook server
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Pricing (display only)
PRICE_USD=29
