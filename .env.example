# Discord
DISCORD_BOT_TOKEN=
# Public Key from Developer Portal → General Information.
# Required to verify Discord's "Webhook Events" requests (APPLICATION_AUTHORIZED).
DISCORD_PUBLIC_KEY=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://oneprompt:oneprompt@localhost:5432/oneprompt

# Polar.sh (https://docs.polar.sh)
# Personal/Organization access token from Polar dashboard → Settings → Developers.
POLAR_ACCESS_TOKEN=
# Webhook secret from Polar dashboard → Settings → Webhooks (starts with polar_whs_).
POLAR_WEBHOOK_SECRET=
# Pro product: $29/mo, 7-day trial, 20 videos/mo on bot owner's hosted Modal.
POLAR_PRODUCT_ID_PRO=
# Studio product: $79/mo, no trial, 100 videos/mo on user's own Modal (BYO).
POLAR_PRODUCT_ID_STUDIO=
POLAR_API_BASE=https://api.polar.sh
# Optional — Polar's hosted thank-you page is used if blank.
POLAR_SUCCESS_URL=
# Trial length configured on the Polar product (used for display only).
POLAR_TRIAL_DAYS=7
# Quotas are RENDER-MINUTES per billing period (a 3-min video spends 3).
PRO_MONTHLY_MINUTES=60
STUDIO_MONTHLY_MINUTES=200
TRIAL_MINUTES=10
# BYO Modal (/setmodal) is Enterprise-only; keep false for public tiers.
ENABLE_BYO=false
# Hard daily fuse on hosted Modal across ALL Pro+free users (cost circuit-breaker).
MAX_HOSTED_VIDEOS_PER_DAY=200

# Encryption — generate ONCE with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: losing this key bricks every stored Modal credential. Back it up.
ENCRYPTION_KEY=

# Modal
MODAL_APP_PATH=./modal_app/app.py
MODAL_GRAPHQL_URL=https://api.modal.com/graphql
# Bot owner's deployed modal_app/app.py — used for free-tier generations
# (deploy once with `cd modal_app && modal deploy app.py`, paste the URL).
ADMIN_MODAL_URL=
# Lifetime free generations per Discord user before /subscribe is required.
FREE_GENERATIONS=2

# ── Video pipeline ────────────────────────────────────────────────────────────
# "internal" = in-process pipeline (LLM → Modal async → R2 → DM). "n8n" = legacy
# dispatch to VIDEO_API_URL. Flip back to n8n any time; no other change needed.
PIPELINE=n8n

# OpenRouter (required when PIPELINE=internal) — writes the scene script.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_BASE=https://openrouter.ai/api/v1

# Cloudflare R2 (required when PIPELINE=internal) — finished-video storage.
# R2 dashboard → your bucket → Settings. Endpoint is https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oneprompt
# Public base the bucket is served from (r2.dev domain or custom domain).
R2_PUBLIC_BASE_URL=

# Shared secret between the bot and the Modal render app's async endpoints.
# Must match the Modal secret:  modal secret create oneprompt-render-auth RENDER_API_KEY=<same value>
RENDER_API_KEY=

# Hard timeout after which a stuck job is failed and the user unblocked.
JOB_TIMEOUT_MINUTES=45
# Max concurrent internal-pipeline jobs.
PIPELINE_MAX_CONCURRENT=4

# API server (video generation, legacy n8n path)
VIDEO_API_URL=https://flow.yayce.com/webhook-test/video-gen-endpoint
VIDEO_API_CALLBACK_SECRET=

# Where the API server reaches the bot's webhook (publicly resolvable)
BOT_PUBLIC_URL=https://bot.oneprompt.app

# Support
SUPPORT_DISCORD_USER_ID=

# Webhook server
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Pricing (display only)
PRICE_USD=29
